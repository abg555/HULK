//ejemplo 25
type Point {
    x = 0;
    y = 0;

    getX() => self.x;
    getY() => self.y;

    setX(x) => self.x := x;
    setY(y) => self.y := y;
}

//ejemplo 26
let pt = new Point() in
    print("x: " @ pt.getX() @ "; y: " @ pt.getY());

//ejemplo 27
let pt = new Point(3,4) in
    print("x: " @ pt.getX() @ "; y: " @ pt.getY());

//ejemplo 28
type PolarPoint inherits Point {
    rho() => sqrt(self.getX() ^ 2 + self.getY() ^ 2);
}

//ejemplo 29
type PolarPoint(phi, rho) inherits Point(rho * sin(phi), rho * cos(phi)) {
}

