// // example: is_as_rtti
// // expect: is_cmp
// // expect: as_cmp
type Base {
    value: Number = 0;
}

type Child inherits Base {
    child_value: Number = 1;
}

let x: Base = new Child() in {
    print(x is Child);
    print(x as Child);
}

