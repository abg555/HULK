// test_strings_mix.hulk
// Mezcla números y strings; verifica conversión implícita cuando sea necesario
// Asumimos que la concatenación convierte números a strings cuando un operando es string

function formatted_num(a: Number, b: Number): String {
    "a=" @ a @ ", b=" @ b
}

function formatted_str(a: String, b: String): String {
    "a=" @ a @ ", b=" @ b
}

{
    print("The answer is: " @ 42);

    // concatenación completa con @@ (si está implementado), prueba con números y strings
    // print("sum: " @@ n);

    // llamadas de prueba en un único bloque global
    print(formatted_num(1, 2));
    print(formatted_str("x", "y"));
}
