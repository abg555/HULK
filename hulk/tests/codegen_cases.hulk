// example: arithmetic_pow
// expect: @llvm.pow.f64
// expect: fadd double
// expect: fmul double
// expect: fdiv double
function math(x: Number, y: Number): Number => (x + y) * 2 ^ 3 / 5;
math(1, 2)

// example: string_concat
// expect: @hulk_format_number
// expect: @hulk_concat_full
// expect: @printf
print("total: " @ 42 @@ "!")

// example: if_elif_chain
// expect: if_then
// expect: if_else
// expect: if_merge
// expect: phi double
function classify(x: Number): Number =>
    if (x < 0) -1
    elif (x == 0) 0
    else 1;

classify(2)

// example: while_expression
// expect: while_cond
// expect: while_body
// expect: while_after
// expect: while_result
let a = 3 in while (a >= 0) {
    a := a - 1;
    a
}

// example: for_range
// expect: for_cond
// expect: for_body
// expect: for_after
// expect: for_result
for (x in range(0, 3)) x + 1

// example: inherited_objects
// expect: obj.Point
// expect: obj.PolarPoint
// expect: malloc
// expect: Point.getX
// expect: PolarPoint.radius
// expect: @llvm.sqrt.f64
type Point {
    x: Number = 0;
    y: Number = 0;

    getX(): Number => self.x;
    getY(): Number => self.y;
}

type PolarPoint inherits Point {
    radius(): Number => sqrt(self.getX() ^ 2 + self.getY() ^ 2);
}

let p = new PolarPoint() in p.radius()

// example: self_field_assignment
// expect: obj.Counter
// expect: Counter.increment
// expect: value_field
type Counter {
    value: Number = 0;

    increment(): Number => self.value := self.value + 1;
    current(): Number => self.value;
}

let c = new Counter() in c.increment()

// example: user_defined_tan
// expect: define double @tan
// expect: call double @tan
function tan(x: Number): Number => x + 1;
function use_tan(x: Number): Number => tan(x);
use_tan(2)

// example: missing_global_expr
// expect-error: No hay expresion global para compilar
function add(a: Number, b: Number): Number => a + b;

// example: print_object_toString
// expect: Box.toString
// expect: @printf
type Box {
    value: Number = 0;

    toString(): String => "Box value";
}

print(new Box())

// example: print_object_fallback
// expect: <Point>
// expect: @printf
type Point {
    x: Number = 0;
}

print(new Point())

// example: vtable_dispatch
// expect: @vtable.Animal
// expect: @vtable.Dog
// expect: method_load
type Animal {
    speak(): String => "...";
}

type Dog inherits Animal {
    speak(): String => "woof";
}

let a: Animal = new Dog() in a.speak()

// example: is_as_rtti
// expect: is_cmp
// expect: as_cmp
type Base {
    value: Number = 0;
}

type Child inherits Base {
    child_value: Number = 1;
}

let x: Base = new Child() in {
    x is Child;
    x as Child;
}

// example: vector_param_return
// expect: vec_alloc
function id_vec(v: Number[]): Number[] => v;
id_vec([1, 2, 3])

// example: vector_if_result
// expect: iftmp_vec
function choose_vec(flag: Boolean, a: Number[], b: Number[]): Number[] => if (flag) a else b;
choose_vec(true, [1], [2])

// example: vector_while_result
// expect: while_result
let i = 0 in while (i < 1) {
    i := i + 1;
    [1, 2]
}

// example: vector_for_result
// expect: for_result
for (x in range(0, 1)) [x]

// example: for_vector_uses_next_current
// expect: vec_next_cursor
// expect: vec_has_next
// expect: vec_current_byte_offset
let v = [1, 2, 3] in for (x in v) x

// example: for_vector_respects_cursor_state
// expect: vec_next_cursor
// expect: vec_current_byte_offset
let v = [1, 2, 3] in {
    v.next();
    for (x in v) x;
}

// example: vector_methods
// expect: vec_alloc
type VecHolder {
    items: Number[] = [1, 2];

    setItems(v: Number[]): Number[] => v;
    getItems(): Number[] => self.items;
}

let h = new VecHolder() in h.setItems(h.getItems())

// example: vector_cast
let v = [1, 2] in v as Number[];

// example: print_vector
// expect: vec_render
// expect: @printf
print([1, 2, 3])

// example: vector_while_dead_loop
let i = 10 in
while (i < 0) {
    i := i + 1;
    [1,2]
}

// example: nested_vector_size
let v = [[1,2], [3,4], [5,6]] in
v.size()

// example: box_type_set_get
type Box {
    items: Number[] = [1];

    set(v: Number[]): Number[] => {
        self.items := v;
        self.items
    };

    get(): Number[] => self.items;
}

let b = new Box() in {
    b.set([7,8]);
    b.get()
}

// example: type_a_self_call
type A {
    f(): Number => 1;
    g(): Number => self.f() + 1;
}

let a = new A() in
a.g()

// example: vector_param_hof
function f(x: Number[], y: Number[]): Number[] => y;

f(
    (let a = [1] in a),
    (let b = [2] in b)
)

// example: type_a_vector_return
type A {
    f(): Number[] => [1,2];
}

let a = new A() in
a.f().size()

// example: vector_double_cast
let v = [1,2,3] in
(v as Number[]) as Number[]

// example: accumulator_while
type Acc {
    v: Number[] = [1];

    add(x: Number): Number[] => {
        self.v := [x];
        self.v
    };
}

let a = new Acc() in
let i = 0 in
while (i < 3) {
    a.add(i);
    i := i + 1;
    a.v
}
